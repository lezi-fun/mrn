#pragma once

#include <string>

// 版本信息
#define MRN_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define MRN_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define MRN_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define MRN_VERSION "@PROJECT_VERSION@"
#define MRN_VERSION_STRING "MRN Compressor v@PROJECT_VERSION@"

namespace mrn {
    class Version {
    public:
        static int getMajor() { return @PROJECT_VERSION_MAJOR@; }
        static int getMinor() { return @PROJECT_VERSION_MINOR@; }
        static int getPatch() { return @PROJECT_VERSION_PATCH@; }
        static std::string getString() { return "@PROJECT_VERSION@"; }
        static std::string getFullString() { return "MRN Compressor v@PROJECT_VERSION@"; }
    };
}
